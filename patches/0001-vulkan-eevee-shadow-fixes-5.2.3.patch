 .../draw/engines/eevee/eevee_shadow.hh        |  4 ++
 .../eevee_shadow_tilemap_finalize.bsl.hh      | 14 +++---
 .../shaders/eevee_shadow_tilemap_init.bsl.hh  | 32 +++++++------
 source/blender/draw/tests/eevee_test.cc       | 45 ++++++++++---------
 .../vulkan/render_graph/vk_command_builder.cc | 12 +++--
 6 files changed, 67 insertions(+), 48 deletions(-)

